#!/bin/bash
# preinst: остановить сервис и снять predeploy-бэкап перед распаковкой.
set -euo pipefail

stopped_units=()

stop_unit() {
  local unit=$1
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$unit" 2>/dev/null; then
    systemctl stop "$unit"
    stopped_units+=("$unit")
  fi
}

restore_units() {
  local unit
  for unit in "${stopped_units[@]}"; do
    systemctl start "$unit" || echo "ОШИБКА: не удалось запустить $unit" >&2
  done
}

# Путь к базе из config.json. Относительный db_path считается от /var/lib/cs2bot.
resolve_db_path() {
  local cfg=/etc/cs2bot/config.json
  local p=""
  if [ -f "$cfg" ]; then
    p=$(sed -n 's/.*"db_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$cfg" | head -1)
  fi
  if [ -z "$p" ]; then
    printf '%s\n' /var/lib/cs2bot/bot.db
    return
  fi
  case "$p" in
    /*) printf '%s\n' "$p" ;;
    *) printf '/var/lib/cs2bot/%s\n' "$p" ;;
  esac
}

# Снимок БД до замены файлов. Нет базы — нечего бэкапить (например, бот
# ещё ни разу не запускался), обновление при этом не блокируем.
predeploy_backup() {
  local db
  db=$(resolve_db_path)
  [ -f "$db" ] || return 0

  if command -v cs2bot-backup >/dev/null 2>&1 && getent passwd cs2bot >/dev/null; then
    if ! runuser -u cs2bot -- cs2bot-backup --prefix predeploy "$db"; then
      echo "ОШИБКА: predeploy-бэкап через cs2bot-backup не удался" >&2
      return 1
    fi
    return 0
  fi

  # Запасной путь: ещё нет cs2bot-backup (теоретически) или нет пользователя.
  sqlite_backup "$db" /var/lib/cs2bot/backups
}

sqlite_backup() {
  local db="$1"
  local dir="$2"

  if ! command -v sqlite3 >/dev/null 2>&1; then
    echo "ОШИБКА: sqlite3 не установлен, predeploy-бэкап $db невозможен" >&2
    return 1
  fi

  mkdir -p "$dir"
  local stamp out tmp
  stamp="$(date +%F-%H%M%S)"
  out="$dir/bot-predeploy-$stamp.db.gz"
  tmp="$dir/.bot-predeploy-$stamp.db.tmp"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp' '$out.tmp'" RETURN
  if ! sqlite3 -cmd '.timeout 30000' "$db" ".backup '$tmp'"; then
    echo "ОШИБКА: sqlite3 .backup не удался ($db)" >&2
    return 1
  fi
  gzip -c "$tmp" >"$out.tmp"
  mv -f "$out.tmp" "$out"
  echo "predeploy backup: $out"
}

case "${1:-}" in
install | upgrade)
  trap restore_units ERR
  stop_unit cs2bot
  stop_unit cs2bot-teams-puller.service
  predeploy_backup
  trap - ERR
  ;;
esac

exit 0
