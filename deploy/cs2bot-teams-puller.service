[Unit]
Description=CS2 teams catalog sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cs2bot
Group=cs2bot
WorkingDirectory=/opt/cs2bot
ExecStart=/opt/cs2bot/teams_puller -config /opt/cs2bot/config.json
# Токены лежат в /opt/cs2bot/config.json (0600, владелец cs2bot),
# в unit-файл секреты не кладем.
NoNewPrivileges=true
PrivateTmp=true
