[Unit]
Description=CS2 teams catalog sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cs2bot
Group=cs2bot
WorkingDirectory=/var/lib/cs2bot
ExecStart=/opt/cs2bot/bin/teams_puller -config /etc/cs2bot/config.json
# Токены лежат в /etc/cs2bot/config.json (0640, root:cs2bot),
# в unit-файл секреты не кладем.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cs2bot
