# Копия для справки: какие переменные читает deploy.sh.
# Скопируй в .env и заполни реальными значениями (.env в гите не хранится).
PANDASCORE_TOKEN="change-me"

# Деплой
DEPLOY_USER="root"
DEPLOY_HOST="1.2.3.4"
DEPLOY_PORT="22"
# Каталог кэша .deb на сервере (для отката)
DEB_CACHE="/var/cache/cs2bot-debs"
DEB_KEEP="3"
